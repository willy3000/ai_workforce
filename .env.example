# Environment for docker-compose (the compose file reads this automatically).
# For running the backend directly with npm, use backend/.env instead.

CLAUDE_API_KEY=PASTE_API_KEY_HERE
GITHUB_TOKEN=PASTE_TOKEN_HERE

# Provider selection: claude | gemini
LLM_PROVIDER=claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Optional shared secret required on every /api request when set.
PLATFORM_API_KEY=

PORT=4000
LOG_LEVEL=info
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000
AGENT_MAX_ITERATIONS=12

# Recommended `true` in production: every repository-mutating workflow step
# then pauses for explicit human approval.
REQUIRE_HUMAN_APPROVAL=false
