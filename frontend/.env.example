# ---------------------------------------------------------------------------
# Console environment. Copy to `.env` and fill in.
#
# Nothing here is prefixed NEXT_PUBLIC_, which is deliberate: every value is
# read server-side only, so no credential ever reaches the browser bundle.
# ---------------------------------------------------------------------------

# Backend location. Read only by the gateway route handler.
BACKEND_URL=http://localhost:4000

# Must match PLATFORM_API_KEY on the backend. The gateway attaches it to
# requests server-side, so the browser never holds a credential that can write
# to your repositories.
PLATFORM_API_KEY=

# --- Console sign-in -------------------------------------------------------
# Password for the operator console. At least 8 characters; use a long random
# one, since this is the only thing between a visitor and an API that can write
# to your repositories and open pull requests.
#
# REQUIRED IN PRODUCTION. Without it the gateway refuses every request in
# production rather than defaulting open — hiding the API key while forwarding
# every request anonymously protected nothing, because the attacker never
# needed the key, only the URL.
#
# Leave unset for local development: the console then runs open, matching the
# backend's own local posture.
OPERATOR_PASSWORD=

# Secret used to sign session cookies. Falls back to PLATFORM_API_KEY when
# unset, so a correctly-configured deployment needs only one secret.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=
