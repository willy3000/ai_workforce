# Backend location. Read SERVER-SIDE ONLY by app/api/gateway — never exposed
# to the browser, which is why there is no NEXT_PUBLIC_ prefix here.
BACKEND_URL=http://localhost:4000

# Must match PLATFORM_API_KEY on the backend when that is set. Kept server-side
# so the browser never holds a credential that can write to your repositories.
PLATFORM_API_KEY=
