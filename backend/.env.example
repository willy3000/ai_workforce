# ---------------------------------------------------------------------------
# AI Engineering Organization Platform - environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# When running via docker-compose, the host is the service name (`mongo`).
MONGODB_URI=mongodb://localhost:27017/ai_engineering_company

# --- AI provider (Anthropic Claude) ---------------------------------------
CLAUDE_API_KEY=PASTE_API_KEY_HERE
# Default model used by every agent unless the agent definition overrides it.
CLAUDE_MODEL=claude-opus-4-8
# Cheaper model used for high-volume, low-stakes calls (summaries, routing).
CLAUDE_FAST_MODEL=claude-haiku-4-5
# Default reasoning effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000
# Max agentic tool-use iterations per agent run (safety brake).
# Slow/tool-heavy local-model agents need room to finish their verification and
# completion report. The per-role tool budgets and provider quotas remain active.
AGENT_MAX_ITERATIONS=24

# --- AI provider selection ------------------------------------------------
# Which provider agents use by default: claude | gemini | ollama
# Individual agents (AgentDefinition.provider) and individual API calls
# (POST /agents/run { provider }) can override this.
LLM_PROVIDER=claude

# --- Google Gemini ---------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RPM_LIMIT=30
GEMINI_TPM_LIMIT=16000

# --- Local Ollama ------------------------------------------------------------
# No API key needed. Point this at wherever `ollama serve` is running — the
# default is the local machine's default port; set it to a LAN address if
# Ollama runs on another box (e.g. http://192.168.1.20:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Must match a model you've pulled (`ollama list` to check).
OLLAMA_MODEL=qwen3.6

# --- GitHub integration ----------------------------------------------------
GITHUB_TOKEN=PASTE_TOKEN_HERE
# Committer identity used when agents push changes.
GIT_AUTHOR_NAME=AI Engineering Company
GIT_AUTHOR_EMAIL=bots@ai-engineering-company.local

# --- Workspace -------------------------------------------------------------
# Root directory where connected repositories are cloned. Relative paths are
# resolved from the backend directory, so starting the API from the repo root
# or from backend uses the same checkout tree. Every filesystem tool is
# sandboxed to a subdirectory of this path.
WORKSPACE_ROOT=./workspaces
# Hard cap on a single file read/write through the tool layer (bytes).
MAX_FILE_BYTES=524288
# Terminal tool timeout (ms) and output cap (bytes).
TERMINAL_TIMEOUT_MS=120000
TERMINAL_MAX_OUTPUT=65536

# --- Safety ----------------------------------------------------------------
# When true, no workflow step that mutates a repository runs without an
# explicit approval call. Recommended in production.
REQUIRE_HUMAN_APPROVAL=false
WORKFLOW_REPAIR_ATTEMPTS=3

# Shared operator secret. Every /api request must send `x-api-key: <value>`.
#
# REQUIRED IN PRODUCTION — the process refuses to boot without it. Leaving it
# unset used to disable authentication silently, including in production, which
# left an API that can write to repositories open to anyone who could reach it.
# Generate one with:  openssl rand -hex 32
PLATFORM_API_KEY=

# --- Access control --------------------------------------------------------
# Exact browser origins allowed to call this API with credentials, comma
# separated (e.g. https://app.example.com). REQUIRED IN PRODUCTION.
#
# Set to `none` when the backend is private and only the Next.js gateway talks
# to it — that is the documented topology and the safest value. The previous
# reflective policy echoed whatever Origin a caller sent, which is not an
# allowlist at all.
CORS_ALLOWED_ORIGINS=none

# Request budgets, applied per client address before any expensive work.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
# Much tighter budget for endpoints that start model work — one admitted
# request there costs real money and minutes.
RATE_LIMIT_MAX_RUNS=20

# --- Execution limits ------------------------------------------------------
# Workflow runs executing concurrently in this process. Excess runs queue.
MAX_CONCURRENT_RUNS=3
# Concurrent runs per project. Must stay 1 until each run gets its own
# checkout — the platform shares one working tree per project, and two runs
# editing it would corrupt each other.
MAX_CONCURRENT_RUNS_PER_PROJECT=1
# Wall-clock ceiling for one run, after which it is cancelled (default 1 hour).
RUN_DEADLINE_MS=3600000
# A run whose lease is older than this is treated as crashed and recoverable.
RUN_LEASE_TIMEOUT_MS=900000

# --- Repository import -----------------------------------------------------
# Hosts a repository may be cloned from, comma separated. The first entry is
# the default for `owner/repo` shorthand. The platform token is attached to the
# clone, so anything listed here is a host you are trusting with it.
GIT_ALLOWED_HOSTS=github.com

# Import from a directory on this server. Useful for air-gapped evaluation and
# inappropriate for a hosted deployment, where it lets any caller copy arbitrary
# server directories into a workspace agents can read.
ALLOW_LOCAL_PATH_IMPORT=true
# When local import is on, confine it to these roots (comma separated). In
# production one of the two must be set: either disable the feature, or fence it.
LOCAL_IMPORT_ROOTS=

# Refuse to import a repository larger than this (bytes, default 1 GiB).
MAX_REPOSITORY_BYTES=1073741824
# Cap on persisted file-index entries, keeping the repository document well
# under MongoDB's 16 MiB limit.
MAX_INDEXED_FILES=20000

# --- Command isolation -----------------------------------------------------
# Agent commands are model-directed and `node`/`python` are Turing-complete, so
# an allowlisted command can still run arbitrary code. `shell: false` and a
# fixed cwd are not OS isolation.
#
# Set this to an argv template that every command is executed through, e.g.
#   docker run --rm --network none -v {cwd}:/w -w /w node:22-alpine
# `{cwd}` is replaced with the project checkout path.
TERMINAL_SANDBOX_COMMAND=

# Explicit acknowledgement required to run commands unsandboxed in production.
# The process refuses to boot in production unless one of these two is set.
ALLOW_UNSANDBOXED_COMMANDS=false
